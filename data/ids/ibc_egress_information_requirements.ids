<?xml version='1.0' encoding='utf-8'?>
<ids xmlns="http://standards.buildingsmart.org/IDS" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://standards.buildingsmart.org/IDS http://standards.buildingsmart.org/IDS/1.0/ids.xsd">
    <info>
        <title>IBC 2021 egress MVD information requirements</title>
        <version>1.0.0</version>
        <description>Machine-readable checkability requirements derived from the structured rule library.</description>
        <author>research@example.invalid</author>
        <purpose>Minimum Viable Demonstrator</purpose>
    </info>
    <specifications>
        <specification name="Doors expose a clear opening width" ifcVersion="IFC4" identifier="IDS-DOOR-CLEAR-WIDTH" description="Information prerequisite for a deterministic IBC MVD check; it does not itself decide regulatory compliance.">
            <applicability minOccurs="0" maxOccurs="unbounded">
                <entity>
                    <name>
                        <simpleValue>IFCDOOR</simpleValue>
                    </name>
                </entity>
            </applicability>
            <requirements>
                <property dataType="IFCLENGTHMEASURE" cardinality="required">
                    <propertySet>
                        <simpleValue>Pset_ComplianceMeasurements</simpleValue>
                    </propertySet>
                    <baseName>
                        <simpleValue>ClearOpeningWidth</simpleValue>
                    </baseName>
                </property>
            </requirements>
        </specification>
        <specification name="Doors expose a clear opening height" ifcVersion="IFC4" identifier="IDS-DOOR-CLEAR-HEIGHT" description="Information prerequisite for a deterministic IBC MVD check; it does not itself decide regulatory compliance.">
            <applicability minOccurs="0" maxOccurs="unbounded">
                <entity>
                    <name>
                        <simpleValue>IFCDOOR</simpleValue>
                    </name>
                </entity>
            </applicability>
            <requirements>
                <property dataType="IFCLENGTHMEASURE" cardinality="required">
                    <propertySet>
                        <simpleValue>Pset_ComplianceMeasurements</simpleValue>
                    </propertySet>
                    <baseName>
                        <simpleValue>ClearOpeningHeight</simpleValue>
                    </baseName>
                </property>
            </requirements>
        </specification>
        <specification name="Spaces expose a geometric representation" ifcVersion="IFC4" identifier="IDS-EGRESS-SPACE-GEOMETRY" description="Information prerequisite for a deterministic IBC MVD check; it does not itself decide regulatory compliance.">
            <applicability minOccurs="0" maxOccurs="unbounded">
                <entity>
                    <name>
                        <simpleValue>IFCSPACE</simpleValue>
                    </name>
                </entity>
            </applicability>
            <requirements>
                <attribute cardinality="required">
                    <name>
                        <simpleValue>Representation</simpleValue>
                    </name>
                </attribute>
            </requirements>
        </specification>
        <specification name="Doors expose an authored swing direction" ifcVersion="IFC4" identifier="IDS-DOOR-SWING-DIRECTION" description="Information prerequisite for a deterministic IBC MVD check; it does not itself decide regulatory compliance.">
            <applicability minOccurs="0" maxOccurs="unbounded">
                <entity>
                    <name>
                        <simpleValue>IFCDOOR</simpleValue>
                    </name>
                </entity>
            </applicability>
            <requirements>
                <property dataType="IFCLABEL" cardinality="required">
                    <propertySet>
                        <simpleValue>Pset_ComplianceRelationships</simpleValue>
                    </propertySet>
                    <baseName>
                        <simpleValue>SwingDirection</simpleValue>
                    </baseName>
                </property>
            </requirements>
        </specification>
        <specification name="Spaces declare topology export completeness" ifcVersion="IFC4" identifier="IDS-EGRESS-SPACE-TOPOLOGY" description="Information prerequisite for a deterministic IBC MVD check; it does not itself decide regulatory compliance.">
            <applicability minOccurs="0" maxOccurs="unbounded">
                <entity>
                    <name>
                        <simpleValue>IFCSPACE</simpleValue>
                    </name>
                </entity>
            </applicability>
            <requirements>
                <property dataType="IFCBOOLEAN" cardinality="required">
                    <propertySet>
                        <simpleValue>Pset_ComplianceTopology</simpleValue>
                    </propertySet>
                    <baseName>
                        <simpleValue>TopologyCoverageComplete</simpleValue>
                    </baseName>
                </property>
            </requirements>
        </specification>
        <specification name="Spaces expose an IBC occupancy classification" ifcVersion="IFC4" identifier="IDS-SPACE-OCCUPANCY-CLASSIFICATION" description="Information prerequisite for a deterministic IBC MVD check; it does not itself decide regulatory compliance.">
            <applicability minOccurs="0" maxOccurs="unbounded">
                <entity>
                    <name>
                        <simpleValue>IFCSPACE</simpleValue>
                    </name>
                </entity>
            </applicability>
            <requirements>
                <classification cardinality="required">
                    <system>
                        <simpleValue>IBC Occupancy Group</simpleValue>
                    </system>
                </classification>
            </requirements>
        </specification>
    </specifications>
</ids>